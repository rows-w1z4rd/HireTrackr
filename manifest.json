{
  "manifest_version": 3,
  "name": "HireTrack",
  "version": "1.0",
  "description": "Track jobs, manage CVs, and write emails — all from your browser.",
  "icons": {
    "16": "icons/favicon_io/favicon-16x16.png",
    "48": "icons/favicon_io/favicon-32x32.png",
    "128": "icons/favicon_io/android-chrome-192x192.png"
  },
  "permissions": ["storage", "activeTab", "scripting", "alarms", "tabs"],
  "action": {
    "default_popup": "popup/popup.html",
    "default_icon": {
      "16": "icons/favicon_io/favicon-16x16.png",
      "48": "icons/favicon_io/favicon-32x32.png"
    }
  },
  "content_scripts": [
    {
      "matches": ["*://*.linkedin.com/*", "*://*.indeed.com/*", "*://*.greenhouse.io/*", "*://*.lever.co/*"],
      "js": ["content/content.js"]
    }
  ],
  "background": {
    "service_worker": "background/background.js"
  }
}